<!-- JAVASCRIPT -->

<script>

function sendWhatsApp(){

let name =
document.getElementById("customerName").value;

let phone =
document.getElementById("customerPhone").value;

let project =
document.getElementById("projectType").value;

let service =
document.getElementById("serviceType").value;

let details =
document.getElementById("details").value;


let whatsappNumber =
"917001843793";


let message =
"SVRT Digital Wall Paint Service Booking\n\n" +

"Name: " + name + "\n" +

"Mobile: " + phone + "\n" +

"Project: " + project + "\n" +

"Service: " + service + "\n" +

"Details: " + details;


let url =
"https://wa.me/" +

whatsappNumber +

"?text=" +

encodeURIComponent(message);


window.open(url,"_blank");

}


function bookingSubmit(){

let name =
document.getElementById("bookingName").value;

let phone =
document.getElementById("bookingPhone").value;

let address =
document.getElementById("bookingAddress").value;


let whatsappNumber =
"917001843793";


let message =
"SVRT Digital Wall Paint Booking\n\n" +

"Name: " + name + "\n" +

"Mobile: " + phone + "\n" +

"Address: " + address;


let url =
"https://wa.me/" +

whatsappNumber +

"?text=" +

encodeURIComponent(message);


window.open(url,"_blank");

}

</script>


